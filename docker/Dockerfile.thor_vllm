# JetPack 7 / Jetson Thor vLLM benchmark image.
# The pinned upstream manifest includes arm64 CUDA 13 / sm_110 support.
ARG BASE_IMAGE_ARM64=vllm/vllm-openai:v0.28.0@sha256:61fc8a896b0a4fbbbdc063bc4b0dbc25ce98e02b5050c24aeb7830ac02039b14
ARG BASE_IMAGE_AMD64=vllm/vllm-openai:v0.28.0@sha256:61fc8a896b0a4fbbbdc063bc4b0dbc25ce98e02b5050c24aeb7830ac02039b14
ARG BASE_STAGE_NAME=base_arm64

FROM ${BASE_IMAGE_ARM64} AS base_arm64
FROM ${BASE_IMAGE_AMD64} AS base_amd64
FROM ${BASE_STAGE_NAME} AS final

ARG username=ros

LABEL com.foresight.jetpack="7" \
      com.foresight.vllm-version="0.28.0"

ENV CUDA_MODULE_LOADING=LAZY \
    PYTORCH_ALLOC_CONF=expandable_segments:False \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    FORESIGHT_CONTAINER_BASE=vllm/vllm-openai:v0.28.0 \
    HOME=/home/${username} \
    HF_HOME=/home/${username}/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/home/${username}/.cache/huggingface \
    TRANSFORMERS_CACHE=/home/${username}/.cache/huggingface

WORKDIR /home/${username}/argo_ws

ENTRYPOINT []
CMD ["/bin/bash", "-l"]
